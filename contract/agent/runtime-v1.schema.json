{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:parley:agent:runtime-v1",
  "oneOf": [
    {
      "$ref": "#/$defs/hello"
    },
    {
      "$ref": "#/$defs/hello_ack"
    },
    {
      "$ref": "#/$defs/execute"
    },
    {
      "$ref": "#/$defs/complete"
    },
    {
      "$ref": "#/$defs/failed"
    },
    {
      "$ref": "#/$defs/cancel"
    },
    {
      "$ref": "#/$defs/assistant_turn"
    },
    {
      "$ref": "#/$defs/tool_request"
    },
    {
      "$ref": "#/$defs/turn_accepted"
    },
    {
      "$ref": "#/$defs/tool_result"
    },
    {
      "$ref": "#/$defs/suspend"
    }
  ],
  "$defs": {
    "opaque": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "provider_version",
        "model_tag",
        "model_digest",
        "tokenizer_digest",
        "context_tokens",
        "template_tokens",
        "max_output_tokens"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "provider_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "model_tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
        },
        "model_digest": {
          "$ref": "#/$defs/digest"
        },
        "tokenizer_digest": {
          "$ref": "#/$defs/digest"
        },
        "context_tokens": {
          "type": "integer",
          "minimum": 256,
          "maximum": 2097152
        },
        "template_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2097151
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "embed_tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
        },
        "embed_digest": {
          "$ref": "#/$defs/digest"
        },
        "embed_dimensions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_version",
        "model_tag",
        "model_digest"
      ],
      "properties": {
        "provider_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "model_tag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2097152
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32768
        }
      }
    },
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "kind",
        "seq",
        "body"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "kind": {
          "const": "hello"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "build",
            "schema_digest",
            "capabilities",
            "namespaces"
          ],
          "properties": {
            "build": {
              "$ref": "#/$defs/digest"
            },
            "schema_digest": {
              "$ref": "#/$defs/digest"
            },
            "capabilities": {
              "const": [
                "structured_role",
                "delegated",
                "embed"
              ]
            },
            "namespaces": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "user",
                "net",
                "pid",
                "ipc",
                "uts"
              ],
              "properties": {
                "user": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                "net": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                "pid": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                "ipc": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                "uts": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                }
              }
            }
          }
        }
      }
    },
    "hello_ack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "kind",
        "seq",
        "body"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "kind": {
          "const": "hello_ack"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capabilities",
            "max_frame_bytes"
          ],
          "properties": {
            "capabilities": {
              "const": [
                "structured_role",
                "delegated",
                "embed"
              ]
            },
            "max_frame_bytes": {
              "const": 524288
            }
          }
        }
      }
    },
    "execute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "kind",
        "seq",
        "body",
        "execution_id",
        "lease_id"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "kind": {
          "const": "execute"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "body": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "profile",
                "deadline_ms",
                "capability"
              ],
              "properties": {
                "mode": {
                  "const": "probe"
                },
                "capability": {
                  "enum": [
                    "structured_role",
                    "embed"
                  ]
                },
                "profile": {
                  "$ref": "#/$defs/profile"
                },
                "deadline_ms": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 120000
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "profile",
                "deadline_ms",
                "inputs",
                "dimensions"
              ],
              "properties": {
                "mode": {
                  "const": "embed"
                },
                "profile": {
                  "$ref": "#/$defs/profile"
                },
                "deadline_ms": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 120000
                },
                "inputs": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {
                    "type": "string",
                    "maxLength": 65536
                  }
                },
                "dimensions": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4096
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "profile",
                "deadline_ms",
                "role",
                "prompt_version",
                "schema_digest",
                "system",
                "input"
              ],
              "properties": {
                "mode": {
                  "const": "structured_role"
                },
                "profile": {
                  "$ref": "#/$defs/profile"
                },
                "deadline_ms": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 120000
                },
                "role": {
                  "enum": [
                    "coach",
                    "template_builder",
                    "interviewer",
                    "briefer",
                    "extractor",
                    "matcher"
                  ]
                },
                "prompt_version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "schema_digest": {
                  "$ref": "#/$defs/digest"
                },
                "system": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 98304
                },
                "input": {
                  "type": "object"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "profile",
                "deadline_ms",
                "task",
                "transcript",
                "tools",
                "continuation"
              ],
              "properties": {
                "mode": {
                  "const": "delegated"
                },
                "profile": {
                  "$ref": "#/$defs/profile"
                },
                "deadline_ms": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 120000
                },
                "task": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                },
                "transcript": {
                  "type": "array",
                  "maxItems": 64,
                  "items": {
                    "$ref": "#/$defs/transcript_message"
                  }
                },
                "tools": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "$ref": "#/$defs/authorized_tool"
                  }
                },
                "continuation": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "turn_no",
                        "results"
                      ],
                      "properties": {
                        "turn_no": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 64
                        },
                        "results": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 4,
                          "items": {
                            "$ref": "#/$defs/tool_result_entry"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        "execution_id": {
          "$ref": "#/$defs/opaque"
        },
        "lease_id": {
          "$ref": "#/$defs/opaque"
        }
      }
    },
    "complete": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "kind",
        "seq",
        "body",
        "execution_id",
        "lease_id"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "kind": {
          "const": "complete"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "body": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "observed",
                "usage"
              ],
              "properties": {
                "mode": {
                  "const": "probe"
                },
                "observed": {
                  "$ref": "#/$defs/observed"
                },
                "usage": {
                  "$ref": "#/$defs/usage"
                },
                "dimensions": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4096
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "observed",
                "usage",
                "vectors"
              ],
              "properties": {
                "mode": {
                  "const": "embed"
                },
                "observed": {
                  "$ref": "#/$defs/observed"
                },
                "usage": {
                  "$ref": "#/$defs/usage"
                },
                "vectors": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {
                    "$ref": "#/$defs/vector"
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "observed",
                "usage",
                "candidate"
              ],
              "properties": {
                "mode": {
                  "const": "structured_role"
                },
                "observed": {
                  "$ref": "#/$defs/observed"
                },
                "usage": {
                  "$ref": "#/$defs/usage"
                },
                "candidate": {
                  "type": "object"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "observed",
                "usage",
                "text"
              ],
              "properties": {
                "mode": {
                  "const": "delegated"
                },
                "observed": {
                  "$ref": "#/$defs/observed"
                },
                "usage": {
                  "$ref": "#/$defs/usage"
                },
                "text": {
                  "type": "string",
                  "maxLength": 32768
                }
              }
            }
          ]
        },
        "execution_id": {
          "$ref": "#/$defs/opaque"
        },
        "lease_id": {
          "$ref": "#/$defs/opaque"
        }
      }
    },
    "failed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "kind",
        "seq",
        "body",
        "execution_id",
        "lease_id"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "kind": {
          "const": "failed"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "enum": [
                "MODEL_UNAVAILABLE",
                "PROFILE_CHANGED",
                "CONTEXT_BUDGET",
                "WORKER_PROTOCOL",
                "RESULT_INVALID",
                "PROVIDER_FAILED",
                "CANCELLED",
                "ISOLATION_UNAVAILABLE"
              ]
            }
          }
        },
        "execution_id": {
          "$ref": "#/$defs/opaque"
        },
        "lease_id": {
          "$ref": "#/$defs/opaque"
        }
      }
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "kind",
        "seq",
        "body",
        "execution_id",
        "lease_id"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "kind": {
          "const": "cancel"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {}
        },
        "execution_id": {
          "$ref": "#/$defs/opaque"
        },
        "lease_id": {
          "$ref": "#/$defs/opaque"
        }
      }
    },
    "capability": {
      "type": "string",
      "enum": [
        "structured_role",
        "delegated",
        "embed"
      ]
    },
    "vector": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "number",
        "multipleOf": 0.0000001
      }
    },
    "tool_call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_ref",
        "name",
        "args"
      ],
      "properties": {
        "call_ref": {
          "$ref": "#/$defs/opaque"
        },
        "name": {
          "$ref": "#/$defs/opaque"
        },
        "args": {
          "type": "object",
          "maxProperties": 32
        }
      }
    },
    "transcript_message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "content"
      ],
      "properties": {
        "role": {
          "enum": [
            "system",
            "user",
            "assistant",
            "tool"
          ]
        },
        "content": {
          "type": "string",
          "maxLength": 32768
        },
        "tool_calls": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/tool_call"
          }
        },
        "tool_call_id": {
          "$ref": "#/$defs/opaque"
        }
      }
    },
    "authorized_tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "parameters"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/opaque"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "tool_result_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "result"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "result": {
          "type": "object"
        }
      }
    },
    "assistant_turn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "kind",
        "seq",
        "body",
        "execution_id",
        "lease_id"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "kind": {
          "const": "assistant_turn"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "calls"
          ],
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 32768
            },
            "calls": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/tool_call"
              }
            }
          }
        },
        "execution_id": {
          "$ref": "#/$defs/opaque"
        },
        "lease_id": {
          "$ref": "#/$defs/opaque"
        }
      }
    },
    "tool_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "kind",
        "seq",
        "body",
        "execution_id",
        "lease_id"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "kind": {
          "const": "tool_request"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "turn_no",
            "ordinal",
            "name",
            "args"
          ],
          "properties": {
            "turn_no": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "ordinal": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "name": {
              "$ref": "#/$defs/opaque"
            },
            "args": {
              "type": "object",
              "maxProperties": 32
            }
          }
        },
        "execution_id": {
          "$ref": "#/$defs/opaque"
        },
        "lease_id": {
          "$ref": "#/$defs/opaque"
        }
      }
    },
    "turn_accepted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "kind",
        "seq",
        "body",
        "execution_id",
        "lease_id"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "kind": {
          "const": "turn_accepted"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "turn_no",
            "ordinals"
          ],
          "properties": {
            "turn_no": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "ordinals": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              }
            }
          }
        },
        "execution_id": {
          "$ref": "#/$defs/opaque"
        },
        "lease_id": {
          "$ref": "#/$defs/opaque"
        }
      }
    },
    "tool_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "kind",
        "seq",
        "body",
        "execution_id",
        "lease_id"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "kind": {
          "const": "tool_result"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "turn_no",
            "ordinal",
            "result"
          ],
          "properties": {
            "turn_no": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "ordinal": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "result": {
              "type": "object",
              "maxProperties": 32
            }
          }
        },
        "execution_id": {
          "$ref": "#/$defs/opaque"
        },
        "lease_id": {
          "$ref": "#/$defs/opaque"
        }
      }
    },
    "suspend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "kind",
        "seq",
        "body",
        "execution_id",
        "lease_id"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "kind": {
          "const": "suspend"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason"
          ],
          "properties": {
            "reason": {
              "enum": [
                "WAITING_JOB",
                "WAITING_OWNER",
                "CANCELLED"
              ]
            }
          }
        },
        "execution_id": {
          "$ref": "#/$defs/opaque"
        },
        "lease_id": {
          "$ref": "#/$defs/opaque"
        }
      }
    }
  }
}

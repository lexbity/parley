{
  "name": "parley-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26.12.0 <27"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "node mock/dev.ts",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "build": "vite build",
    "e2e:mock": "playwright test --project=mock",
    "e2e:integrated": "playwright test --project=rust",
    "e2e:a11y": "playwright test e2e/accessibility.spec.ts --project=mock --project=rust"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@jspreadsheet-ce/vue": "5.0.1",
    "@xyflow/vue": "2.0.2",
    "jspreadsheet-ce": "5.0.4",
    "jsuites": "5.13.5",
    "vue": "3.5.46"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "@vitest/coverage-v8": "^5.1.1",
    "@vue/test-utils": "2.6.0",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  }
}

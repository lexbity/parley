#!/usr/bin/env bash
# Per-slice proof runner (RFC-0004 "scripts/prove"). Runs the slice's Rust
# integration tests and its Playwright spec on both the mock and rust
# projects, then requires fresh machine-readable reports with positive
# executed counts via ci/trace.py.
#
# Usage: scripts/prove SLICE_ID    (lowercase s01..s12)
set -euo pipefail

if [ "$#" -ne 1 ]; then
  echo "usage: scripts/prove SLICE_ID" >&2
  exit 2
fi
slice=$1
if [[ ! "$slice" =~ ^(s(0[1-9]|1[0-2])|p0[1-4])$ ]]; then
  echo "invalid slice ID: $slice (expected s01..s12 or p01..p04)" >&2
  exit 2
fi
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
artifacts="$root/artifacts"
mkdir -p "$artifacts"
proof_dir=$(mktemp -d "$artifacts/prove-$slice.XXXXXX")
printf '\n=== prove %s: reports in %s ===\n' "$slice" "$proof_dir"

printf '\n=== prove %s: cargo test -p parley-service --test %s ===\n' "$slice" "$slice"
cargo test --locked -p parley-service --test "$slice" 2>&1 |
  tee "$proof_dir/cargo-test.log"
if [[ "$slice" == "s04" ]]; then
  # The offline Extractor evaluation is a CLI capability, not a service test.
  # Include its unfiltered crate suite in the same fresh trace log so EV-4 is
  # qualified by the actual machine-readable command test.
  printf '\n=== prove %s: cargo test -p parley-cli (S04 offline eval) ===\n' "$slice"
  cargo test --locked -p parley-cli 2>&1 |
    tee -a "$proof_dir/cargo-test.log"
fi

# The rust project builds the Vite bundle and release binary once as a
# Playwright setup dependency. The mock project has no build dependency.
printf '\n=== prove %s: playwright e2e/%s.spec.ts (mock + rust) ===\n' "$slice" "$slice"
(
  cd web
  PARLEY_PLAYWRIGHT_JSON="$proof_dir/playwright.json" \
    PARLEY_PLAYWRIGHT_OUTPUT="$proof_dir/browser" \
    pnpm exec playwright test "e2e/$slice.spec.ts" --project=mock --project=rust
)

printf '\n=== prove %s: trace --require-executed ===\n' "$slice"
python3 ci/trace.py --slice "$slice" --require-executed \
  --cargo-log "$proof_dir/cargo-test.log" \
  --playwright-json "$proof_dir/playwright.json"

printf '\nprove %s: complete.\n' "$slice"

#!/usr/bin/env bash
# Per-slice proof runner (RFC-0004 "scripts/prove", UCR-001 U01). Runs the
# slice's Rust integration tests and its Playwright spec on both the mock and
# rust projects, then requires fresh machine-readable reports with positive
# executed counts via ci/trace.py.
#
# Usage: scripts/prove SLICE_ID    (lowercase s01..s12, p01..p04, r01..r04, u01..u09)
set -euo pipefail

if [ "$#" -ne 1 ]; then
  echo "usage: scripts/prove SLICE_ID" >&2
  exit 2
fi
slice=$1
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"

# The accepted ID set has one source of truth: ci/common.py SLICE_ORDER.
# Read it from the module instead of maintaining a second regex here.
allowed_slices=$(python3 -B -c 'import sys; sys.path.insert(0, "ci"); from common import SLICE_ORDER; print("|".join(SLICE_ORDER))')
if [[ "|$allowed_slices|" != *"|$slice|"* ]]; then
  echo "invalid slice ID: $slice (expected one of: ${allowed_slices//|/, })" >&2
  exit 2
fi

# Semantic slice IDs can differ from the cargo integration target name (s12
# is proved by tests/s12_queue_sheet.rs). ci/trace.py owns that mapping.
cargo_target=$(python3 -B -c 'import sys; sys.path.insert(0, "ci"); from trace import rust_test_target; print(rust_test_target(sys.argv[1]))' "$slice")
spec="e2e/$slice.spec.ts"

artifacts="$root/artifacts"
mkdir -p "$artifacts"
proof_dir=$(mktemp -d "$artifacts/prove-$slice.XXXXXX")
printf '\n=== prove %s: reports in %s ===\n' "$slice" "$proof_dir"

printf '\n=== prove %s: cargo test -p parley-service --test %s ===\n' "$slice" "$cargo_target"
cargo test --locked -p parley-service --test "$cargo_target" 2>&1 |
  tee "$proof_dir/cargo-test.log"
if [[ "$slice" == "s04" ]]; then
  # The offline Extractor evaluation is a CLI capability, not a service test.
  # Include its unfiltered crate suite in the same fresh trace log so EV-4 is
  # qualified by the actual machine-readable command test.
  printf '\n=== prove %s: cargo test -p parley-cli (S04 offline eval) ===\n' "$slice"
  cargo test --locked -p parley-cli 2>&1 |
    tee -a "$proof_dir/cargo-test.log"
fi

# The rust project builds the Vite bundle and release binary once as a
# Playwright setup dependency. The mock project has no build dependency.
printf '\n=== prove %s: playwright %s (mock + rust) ===\n' "$slice" "$spec"
(
  cd web
  PARLEY_PLAYWRIGHT_JSON="$proof_dir/playwright.json" \
    PARLEY_PLAYWRIGHT_OUTPUT="$proof_dir/browser" \
    pnpm exec playwright test "$spec" --project=mock --project=rust
)

printf '\n=== prove %s: trace --require-executed ===\n' "$slice"
python3 ci/trace.py --slice "$slice" --require-executed \
  --cargo-log "$proof_dir/cargo-test.log" \
  --playwright-json "$proof_dir/playwright.json"

printf '\nprove %s: complete.\n' "$slice"

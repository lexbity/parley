{
  "type": "object",
  "additionalProperties": false,
  "required": ["questions"],
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_key", "text"],
        "properties": {
          "question_key": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "text": { "type": "string", "minLength": 4, "maxLength": 1200 }
        }
      }
    }
  }
}

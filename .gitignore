# Project instructions: ./devdocs stays in .gitignore (AGENTS.md)
/devdocs

# Rust
/target
/fuzz/target/
/fuzz/corpus/
*.profraw
*.profdata

# Node / frontend build output
node_modules/
web/dist/
# coverage-summary.json stays tracked on purpose: ci/coverage.py ratchets on it
web/coverage/*
!web/coverage/coverage-summary.json

# Python bytecode (ci verifiers)
__pycache__/
*.py[cod]

# Test and tooling artifacts
/artifacts/
web/artifacts/
test-results/
playwright-report/
blob-report/

# Local runtime data (never commit workspaces or databases)
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.db

# Environment and editor noise
.env
.env.*
*.swp
.DS_Store
.idea/
.vscode/

# Agent tools
.zcode
.codex
